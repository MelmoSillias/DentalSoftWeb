# Copier le contenu dans Environment du service Docker Compose Dokploy.
# Une stack = un cabinet. Ne pas inclure les chevrons dans les valeurs réelles.
# Unique sur le serveur, stable : lettres minuscules, chiffres et tirets.
# Deux installations d'un même cabinet doivent avoir des INSTANCE_ID différents.
INSTANCE_ID=demo-prod
CABINET=default
ADMIN_URL=https://admin.example.com
PATIENT_URL=https://patient.example.com

# Générer cinq secrets distincts (par ex. openssl rand -hex 32).
APP_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE
DB_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
DB_ROOT_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET
JWT_PASSPHRASE=REMPLACER_PAR_UN_SECRET_STABLE
MERCURE_JWT_SECRET=REMPLACER_PAR_UN_SECRET_DE_32_OCTETS_MINIMUM

# Valeurs facultatives : les mêmes défauts sont définis dans le Compose.
DB_NAME=dentalsoft
DB_USER=dentalsoft
DB_SERVER_VERSION=11.4.0-MariaDB
DB_BUFFER_POOL_SIZE=128M
DB_MAX_CONNECTIONS=50

# Plafonds par conteneur, pas de la RAM réservée. Somme par défaut : 2304 Mio.
DB_MEMORY_LIMIT=768M
API_MEMORY_LIMIT=1024M
FRONTEND_MEMORY_LIMIT=128M
PATIENT_MEMORY_LIMIT=128M
MERCURE_MEMORY_LIMIT=256M
FRANKENPHP_IMAGE=dunglas/frankenphp:1.13.4-php8.2-bookworm
APP_INTERNET_FEATURES_ENABLED=1
TRUSTED_PROXIES=REMOTE_ADDR
CORS_ALLOW_ORIGIN=a^
RUN_MIGRATIONS=1
ENABLE_EMBEDDED_WORKER=1
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MESSENGER_TIME_LIMIT=3600
MESSENGER_MEMORY_LIMIT=128M
SMS_POLL_INTERVAL=60
SMS_DISPATCH_LIMIT=20
MERCURE_TOPIC_NAMESPACE=dentalsoft
MERCURE_PUBLISH_TIMEOUT=0.8
MERCURE_PUBLISH_MAX_DURATION=1.2
MERCURE_CIRCUIT_COOLDOWN_SECONDS=60
MERCURE_HISTORY_SIZE=10000

# Notifications Web Push facultatives. Conserver les clés entre déploiements.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
