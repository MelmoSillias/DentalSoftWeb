{% extends 'layout.html.twig' %}

{% block title %}Envoyer une notification{% endblock %}

{% block main %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Notifications manuelles</h1>
    <ol class="breadcrumb mb-4 d-flex flex-wrap">
        <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
        <li class="breadcrumb-item active">Notifications</li>
    </ol>
 
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Envoyer une notification</h6>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.recipients) }}
                    {{ form_widget(form.recipients, {'attr': {'class': 'form-control', 'size': 8}}) }}
                    {{ form_errors(form.recipients) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.message) }}
                    {{ form_widget(form.message, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.message) }}
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.priority) }}
                        {{ form_widget(form.priority, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.priority) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.link) }}
                        {{ form_widget(form.link, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.link) }}
                    </div>
                </div>
                <div class="d-flex gap-2">
                    {{ form_widget(form.submit) }}
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
