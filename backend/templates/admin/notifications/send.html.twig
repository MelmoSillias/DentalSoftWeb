{% extends 'layout.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block main %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-1">Centre d'alertes</p>
            <h2 class="h4 mb-0">Envoyer une notification</h2>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_dashboard') }}">
            <i class="fas fa-arrow-left mr-2"></i>Retour au dashboard
        </a>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="form-group">
                            {{ form_label(form.recipients) }}
                            {{ form_widget(form.recipients, {'attr': {'class': 'form-control'}}) }}
                            <small class="form-text text-muted">Sélectionnez un ou plusieurs utilisateurs.</small>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                {{ form_label(form.priority) }}
                                {{ form_widget(form.priority, {'attr': {'class': 'form-control'}}) }}
                            </div>
                            <div class="form-group col-md-6">
                                {{ form_label(form.link) }}
                                {{ form_widget(form.link, {'attr': {'class': 'form-control'}}) }}
                                <small class="form-text text-muted">Lien complet ou relatif.</small>
                            </div>
                        </div>
                        <div class="form-group mb-4">
                            {{ form_label(form.message) }}
                            {{ form_widget(form.message, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <button class="btn btn-primary"><i class="fas fa-paper-plane mr-2"></i>Envoyer</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">Rappels</h5>
                    <ul class="list-unstyled mb-0 text-muted">
                        <li class="mb-2"><i class="fas fa-check text-success mr-2"></i>La priorité ajuste la couleur et la position dans les flux.</li>
                        <li class="mb-2"><i class="fas fa-check text-success mr-2"></i>Utilisez des messages concis (200 caractères recommandés).</li>
                        <li class="mb-2"><i class="fas fa-check text-success mr-2"></i>Le lien doit pointer vers une page accessible par les destinataires.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
