<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Fiche patient – {{ patient.nom }} {{ patient.prenom }}</title>
  <style>
    :root {
      --primary: #0f4c75;
      --muted: #5f6c7b;
      --border: #d9e2ec;
      --bg: #f6f8fb;
    }
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background: var(--bg);
      color: #1f2d3d;
    }
    header {
      text-align: center;
      margin-bottom: 24px;
    }
    .paper {
      position: relative;
      background: #fff;
      padding: 24px; 
      border-radius: 8px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .paper::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('{{ asset('img/logo.png') }}') center center no-repeat;
      background-size: 60% auto;
      opacity: 0.06;
      pointer-events: none;
    }
    .header-banner {
      width: 100%;
      max-height: 120px;
      object-fit: contain;
      margin-bottom: 8px;
    }
    .header-meta {
      font-size: 11px;
      color: var(--muted);
      letter-spacing: 0.3px;
    }
    .section-title {
      margin: 26px 0 12px;
      font-size: 16px;
      color: var(--primary);
      display: inline-block;
      position: relative;
      padding-left: 18px;
    }
    .section-title::before {
      content: "◆";
      position: absolute;
      left: 0;
      top: -1px;
      color: var(--primary);
      font-size: 12px;
    }
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      font-size: 13px;
    }
    .info-table th {
      width: 210px;
      text-align: left;
      padding: 8px 10px;
      color: var(--muted);
      font-weight: 600;
      border-bottom: 1px solid var(--border);
      background: #f9fbfd;
    }
    .info-table td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
    }
    .info-table tr:nth-child(even) td {
      background: #fafbff;
    }
    ul {
      list-style: none;
      padding-left: 0;
      margin: 0 0 8px;
      font-size: 13px;
    }
    ul li {
      margin: 4px 0;
      padding-left: 14px;
      position: relative;
    }
    ul li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--primary);
    }
    .muted {
      color: var(--muted);
      font-size: 12px;
    }
    @media print {
      @page { margin: 10mm; }
      body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; color-adjust: exact; }
      .paper { box-shadow: none; }
      .header-banner { max-height: 90px; }
      h2 { color: #000; }
      table { page-break-inside: avoid; }
    }
  </style>
  <script src="{{ asset('js/admin/patient/printinfosperso.js') }}"></script>
</head>
<body>
  <div class="paper">
    <header>
      <img src="{{ asset('img/header-big.jpeg') }}" alt="Cabinet Dentaire Orodent" class="header-banner">
      <h3>Dossier patient</h3>
    </header>

    <h2 class="section-title">Informations personnelles</h2>
    <table class="info-table">
      <tr><th>Nom</th>                   <td>{{ patient.nom }}</td></tr>
      <tr><th>Prénom</th>                <td>{{ patient.prenom }}</td></tr>
      <tr><th>Date de naissance</th>     <td>{{ patient.dateNaissance|date('d/m/Y') }}</td></tr>
      <tr><th>Sexe</th>                  <td>{{ patient.sexe }}</td></tr>
      <tr><th>Lieu de naissance</th>     <td>{{ patient.lieuNaissance ?? '—' }}</td></tr>
      <tr><th>Profession</th>            <td>{{ patient.profession ?? '—' }}</td></tr>
      <tr><th>Email</th>                 <td>{{ patient.email ?? '—' }}</td></tr>
      <tr><th>Téléphone</th>             <td>{{ patient.telephone }}</td></tr>
      <tr><th>Adresse</th>               <td>{{ patient.adresse }}</td></tr>
      <tr><th>Numéro de carnet</th>      <td>{{ patient.numCarnet }}</td></tr>
      <tr><th>Groupe sanguin</th>        <td>{{ patient.groupeSanguin }}</td></tr>
      <tr><th>Date d'inscription</th>    <td>{{ patient.dateInscription|date('d/m/Y H:i') }}</td></tr>
      <tr>
            <th>Contact d'urgence</th>
            <td>
              {% if patient.contactUrgence %}
              {{ patient.contactUrgence.nom }} ({{ patient.contactUrgence.lienParente }})
              <br>
              Tél : {{ patient.contactUrgence.telephone }}
              {% else %}
              Aucun contact d'urgence disponible.
              {% endif %}
            </td>
      </tr>
    </table>

    <h2 class="section-title">Allergies</h2>
    {% if patient.allergies|length %}
      <ul>
        {% for a in patient.allergies %}
          <li>{{ a.libelle }}{% if a.description %} : {{ a.description }}{% endif %}</li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="muted">Aucune allergie renseignée.</p>
    {% endif %}

    <h2 class="section-title">Antécédents médicaux</h2>
    {% if patient.antecedents|length %}
      <ul>
        {% for ant in patient.antecedents %}
          <li>
            {{ ant.type }}
            {% if ant.description %} ({{ ant.description }}){% endif %}
            {% if ant.dateEnregistrement %} – {{ ant.dateEnregistrement|date('d/m/Y') }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="muted">Aucun antécédent médical enregistré.</p>
    {% endif %}
  </div>
</body>
</html>
