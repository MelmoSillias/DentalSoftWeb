{# Section Paramètres : formulaires de configuration utilisateur #}
<section id="parametres" class="ds-section">
    <!-- En-tête section paramètres -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h2 class="h4 mb-1">Paramètres</h2>
            <p class="text-muted mb-0">Préférences utilisateur et sécurité.</p>
        </div>
        <div class="d-flex ds-actions">
            <button class="btn btn-outline-danger" onclick="logout()">Déconnexion</button>
        </div>
    </div>

    <!-- Formulaire paramètres -->
    <div class="card ds-card">
        <div class="card-body">
            <form class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nom complet</label>
                    <input type="text" class="form-control" placeholder="Nom Prénom" value="Utilisateur Test">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="email@example.com" value="demo@example.com">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Langue</label>
                    <select class="form-select">
                        <option>Français</option>
                        <option>Anglais</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Notifications</label>
                    <select class="form-select">
                        <option>Activer</option>
                        <option>Désactiver</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Signature</label>
                    <textarea class="form-control" rows="3" placeholder="Signature email / rapports"></textarea>
                </div>
                <div class="col-12 d-flex ds-actions">
                    <button type="button" class="btn btn-primary" onclick="saveSettings()">Sauvegarder</button>
                    <button type="reset" class="btn btn-outline-secondary">Réinitialiser</button>
                </div>
            </form>
        </div>
    </div>
</section>
