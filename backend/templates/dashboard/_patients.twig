{# Section Patients : recherche + table + actions #}
<section id="patients" class="ds-section">
    <!-- En-tête section patients -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h2 class="h4 mb-1">Patients</h2>
            <p class="text-muted mb-0">Rechercher, consulter, modifier ou supprimer un patient.</p>
        </div>
        <div class="d-flex ds-actions">
            <button class="btn btn-success">Ajouter Patient</button>
        </div>
    </div>

    <!-- Barre de recherche -->
    <div class="card ds-card mb-3">
        <div class="card-body">
            <form class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label">Rechercher un patient</label>
                    <input type="text" class="form-control" placeholder="Nom, téléphone...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Filtre</label>
                    <select class="form-select">
                        <option>Tous</option>
                        <option>Dernier RDV &lt; 30j</option>
                        <option>Sans RDV</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Actions rapides</label>
                    <div class="d-flex ds-actions">
                        <button type="button" class="btn btn-outline-primary btn-sm">Filtrer</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm">Réinitialiser</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Table des patients -->
    <div class="card ds-card">
        <div class="card-body">
            <div class="ds-table-wrap">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Âge</th>
                            <th>Dernier RDV</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-row="1">
                            <td class="fw-semibold">Traoré Aïcha</td>
                            <td>32</td>
                            <td>2025-12-20</td>
                            <td class="d-flex ds-actions">
                                <button class="btn btn-outline-primary btn-sm" title="Voir détails" onclick="openPatientDetails(1)">👁️</button>
                                <button class="btn btn-outline-warning btn-sm" title="Modifier" onclick="editPatient(1)">✏️</button>
                                <button class="btn btn-outline-danger btn-sm" title="Supprimer" onclick="deletePatient(1)">🗑️</button>
                                <button class="btn btn-outline-success btn-sm" title="Ajouter RDV" onclick="addRdv(1)">➕ RDV</button>
                            </td>
                        </tr>
                        <tr data-row="2">
                            <td class="fw-semibold">Diallo Moussa</td>
                            <td>45</td>
                            <td>2025-12-18</td>
                            <td class="d-flex ds-actions">
                                <button class="btn btn-outline-primary btn-sm" onclick="openPatientDetails(2)">👁️</button>
                                <button class="btn btn-outline-warning btn-sm" onclick="editPatient(2)">✏️</button>
                                <button class="btn btn-outline-danger btn-sm" onclick="deletePatient(2)">🗑️</button>
                                <button class="btn btn-outline-success btn-sm" onclick="addRdv(2)">➕ RDV</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
