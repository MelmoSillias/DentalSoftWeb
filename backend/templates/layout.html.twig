			<script>
				$('.close-btn').on('click', function () {
$(this).closest('.modal').modal('hide');
});

function showToastModal({
message,
type = 'info',
icon,
duration = 1500
} = {}) {
const $dialog = $('#genericModalDialog');
const $content = $('#genericModalContent');
const $iconEl = $('#genericModalIcon');
const $msgEl = $('#genericModalMessage');

const bgClasses = {
	success: 'bg-success text-white',
	error: 'bg-danger  text-white',
	warning: 'bg-warning text-dark',
	info: 'bg-info    text-white'
};

$content.removeClass('bg-success bg-danger bg-warning bg-info text-white text-dark').addClass(bgClasses[type] || bgClasses.info);

// 2. Icône
const iconClasses = {
success: 'fas fa-check-circle',
error: 'fas fa-times-circle',
warning: 'fas fa-exclamation-triangle',
info: 'fas fa-info-circle'
};

$iconEl.attr('class', (icon || iconClasses[type] || iconClasses.info) + ' fa-3x mb-3');

$msgEl.text(message);

$('#genericModal').modal('show');

if (duration > 0) {
setTimeout(() => $('#genericModal').modal('hide'), duration);
}
}

const $loading = $('#topbarLoading');
const showLoading = () => $loading.show();
const hideLoading = () => $loading.hide();

$(document).on('ajaxStart', showLoading);
$(document).on('ajaxStop', hideLoading);

$('#topbarRefreshBtn').on('click', function () {
showLoading();
window.location.reload();
});

$('a').on('click', function (e) {
const href = $(this).attr('href');
if (! href || href.startsWith('#') || href.startsWith('javascript:')) 
return;



if (this.target === '_blank') 
return;

e.preventDefault();
showLoading();
window.location.href = href;
});

// Update sidebar toggle chevron and position on mobile
function updateSidebarToggle() {
	const $icon = $('#sidebarToggleIcon');
	const $sidebar = $('.sidebar');
	const $toggle = $('#sidebarToggleTop');

	// Compute actual sidebar width (even when off-screen) to align toggle on its edge
	const sidebarRect = $sidebar[0] ? $sidebar[0].getBoundingClientRect() : null;
	const sidebarWidth = sidebarRect ? sidebarRect.width : 0;
	const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
	const baseLeft = 0.5 * rem; // matches CSS left: 0.5rem
	const toggleHalf = ($toggle.outerWidth() || 0) / 2;

	if ($sidebar.hasClass('toggled')) {
		$icon.removeClass('fa-chevron-right').addClass('fa-chevron-left');
		const offsetPx = Math.max(0, sidebarWidth - toggleHalf - baseLeft);
		$toggle.css('transform', `translateX(100px)`);
	} else {
		$icon.removeClass('fa-chevron-left').addClass('fa-chevron-right');
		$toggle.css('transform', 'translateX(0)');
	}
}

$(document).ready(function () {
	// initialize state
	updateSidebarToggle();
	// listen to sb-admin toggles
	$('#sidebarToggle, #sidebarToggleTop').on('click', function () {
		// small delay to allow classes to be toggled by sb-admin script
		setTimeout(updateSidebarToggle, 50);
	});
	// ensure position updates on resize
	$(window).on('resize', updateSidebarToggle);
});
			</script>

