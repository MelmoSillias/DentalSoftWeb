<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Dashboard
			{% endblock %}
		</title>

		<link href="{{ asset('sb-admin/vendor/fontawesome-free/css/all.min.css') }}" rel="stylesheet" type="text/css">
		<link href="{{ asset('font/XRXV3I6Li01BKofINeaB.woff2') }}" rel="stylesheet">
		<link href="{{ asset('sb-admin/vendor/datatables/datatables.min.css') }}" rel="stylesheet">
		<link href="{{ asset('sb-admin/css/sb-admin-2.min.css') }}" rel="stylesheet">

		<style>
			body {
				background-color: rgb(255, 255, 255);
			}
			html {
				font-size: 1rem;
			}
			:root {
				--sidebar-width: 14rem;
				--sidebar-collapsed-width: 6.5rem;
			}
			#accordionSidebar {
				position: fixed;
				top: 0;
				left: 0;
				height: 100vh;
				overflow-y: auto;
				width: var(--sidebar-width);
				z-index: 1040;
			}
			.sidebar.toggled {
				width: var(--sidebar-collapsed-width) !important;
				transition: margin 0.3s ease, width 0.3s ease;
			}
			.sidebar {
				transition: margin 0.3s ease, width 0.3s ease;
			}
			.sidebar .nav-link,
			.navbar .nav-link,
			.collapse-inner .collapse-item {
				transition: all 0.2s ease-in-out;
			}
			.sidebar .nav-link:hover,
			.navbar .nav-link:hover,
			.collapse-inner .collapse-item:hover {
				background-color: rgba(255, 255, 255, 0.1);
			}
			#sidebarToggle,
			#sidebarToggleTop {
				transition: transform 0.3s ease;
			}
			#sidebarToggle:hover,
			#sidebarToggleTop:hover {
				transform: rotate(90deg);
			}
			#content-wrapper {
				margin-left: var(--sidebar-width);
				min-height: 100vh;
			}
			body.sidebar-toggled #content-wrapper {
				margin-left: var(--sidebar-collapsed-width);
			}
			.topbar {
				position: fixed;
				top: 0;
				left: var(--sidebar-width);
				right: 0;
				width: calc(100% - var(--sidebar-width));
				z-index: 1030;
			}
			body.sidebar-toggled .topbar {
				left: var(--sidebar-collapsed-width);
				width: calc(100% - var(--sidebar-collapsed-width));
			}
			#content {
				padding-top: 4.5rem;
			}
			@media(max-width: 768px) {
				#accordionSidebar {
					transform: translateX(-100%);
				}
				#accordionSidebar.toggled {
					transform: translateX(0);
				}

				/* Mobile sidebar toggle button: white circle with blue chevron, pulse on border */
				#sidebarToggleTop {
					position: fixed;
					top: 1rem;
					left: 0.5rem;
					bottom: auto;
					width: 2.5rem;
					height: 2.5rem;
					z-index: 900999;
					background: #ffffff;
					border-radius: 50%;
					display: flex;
					align-items: center;
					justify-content: center;
					border: 2px solid rgba(0,0,0,0.06);
					box-shadow: 0 2px 6px rgba(0,0,0,0.08);
					padding: 0;
				}

				#sidebarToggleTop i {
					color: #007bff; /* blue chevron */
					font-size: 1.05rem;
				}

				#sidebarToggleTop::after {
					content: '';
					position: absolute;
					left: -6px;
					top: -6px;
					width: calc(100% + 12px);
					height: calc(100% + 12px);
					border-radius: 50%;
					pointer-events: none;
					box-shadow: 0 0 0 0 rgba(0,123,255,0.18);
					animation: pulse-toggle 2s infinite;
				}

				@keyframes pulse-toggle {
					0% { box-shadow: 0 0 0 0 rgba(0,123,255,0.18); }
					70% { box-shadow: 0 0 0 10px rgba(0,123,255,0); }
					100% { box-shadow: 0 0 0 0 rgba(0,123,255,0); }
				}

				/* When sidebar is visible, place toggle at sidebar border and follow the sidebar animation */
				#sidebarToggleTop {
					transition: transform 0.3s ease;
				}
				.topbar,
				body.sidebar-toggled .topbar {
					left: 0;
					width: 100%;
				}
				#content-wrapper,
				body.sidebar-toggled #content-wrapper {
					margin-left: 0;
				}
			}
		</style>

		{# Importmap removed in favor of direct script includes #}
		{% block stylesheets %}{% endblock %}
