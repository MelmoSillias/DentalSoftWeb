{% extends 'layout.html.twig' %}

{% block title %}Manuel DentalSoft{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --manual-bg: #f7f9fc;
            --manual-surface: #ffffff;
            --manual-border: #e4e8f0;
            --manual-text: #1f2a3d;
            --manual-muted: #5c6675;
            --manual-accent: #0d6efd;
            --manual-accent-2: #22c55e;
            --manual-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            --manual-sidebar: 270px;
        }

        html { scroll-behavior: smooth; }

        body { background: var(--manual-bg); color: var(--manual-text); }

        @media print {
            body { background: #fff; }
            .manual-sidebar, .manual-hero-actions { display: none !important; }
            .manual-container { padding: 0 !important; max-width: 100% !important; }
            .manual-card { box-shadow: none !important; border-color: #d7dce5 !important; }
        }

        .manual-container { margin: 0 auto; padding: 1.5rem 1.25rem 2.5rem; }

        .manual-hero {
            background: linear-gradient(120deg, rgba(13,110,253,0.12), rgba(34,197,94,0.10));
            border: 1px solid var(--manual-border);
            box-shadow: var(--manual-shadow);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }

        .manual-hero h1 { font-weight: 700; margin-bottom: .25rem; }
        .manual-hero p { margin: 0; color: var(--manual-muted); }

        .manual-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(var(--manual-sidebar), 300px); gap: 1.25rem; align-items: start; }

        .manual-sidebar {
            position: sticky;
            top: 5.5rem;
            align-self: start;
            background: var(--manual-surface);
            border: 1px solid var(--manual-border);
            border-radius: 14px;
            padding: 0.75rem;
            box-shadow: var(--manual-shadow);
        }

        .manual-sidebar .nav { gap: .15rem; }
        .manual-sidebar .nav-link {
            border-radius: .45rem;
            color: var(--manual-text);
            padding: .45rem .65rem;
            font-weight: 500;
        }
        .manual-sidebar .nav-link:hover { background: rgba(13,110,253,0.08); }
        .manual-sidebar .nav-link.active { background: rgba(13,110,253,0.16); color: #0b5ed7; font-weight: 700; }

        .manual-content { min-width: 0; }

        .manual-card {
            background: var(--manual-surface);
            border: 1px solid var(--manual-border);
            border-radius: 14px;
            box-shadow: var(--manual-shadow);
            padding: 1.25rem;
        }

        .manual-section { margin-bottom: 1.5rem; scroll-margin-top: 6.5rem; }
        .manual-section h2 { font-weight: 700; margin-bottom: .35rem; }
        .manual-section p { color: var(--manual-muted); }

        .manual-pill { display: inline-flex; gap: .5rem; align-items: center; padding: .35rem .65rem; border-radius: 999px; background: rgba(13,110,253,0.08); color: #0b5ed7; font-weight: 600; font-size: .95rem; }

        .manual-placeholder {
            border: 1px dashed var(--manual-border);
            border-radius: 12px;
            background: linear-gradient(120deg, rgba(13,110,253,0.06), rgba(34,197,94,0.06));
            padding: 0.85rem 1rem;
            font-weight: 600;
            color: var(--manual-text);
        }

        .manual-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }

        .manual-list { padding-left: 1.1rem; margin: 0; color: var(--manual-text); }

        .manual-tag { display: inline-block; padding: .2rem .5rem; border-radius: 6px; background: rgba(34,197,94,0.12); color: #138f46; font-weight: 600; font-size: .9rem; }

        .manual-action { border: 1px solid var(--manual-border); border-radius: 12px; padding: 1rem; background: #fdfefe; }
        .manual-action h4 { margin: 0 0 .4rem; font-weight: 700; }
        .manual-action small { color: var(--manual-muted); }
        .manual-action dl { margin: 0; }
        .manual-action dt { font-weight: 700; margin-top: .35rem; }
        .manual-action dd { margin-left: 0; color: var(--manual-text); }

        .manual-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
        .manual-step { border: 1px solid var(--manual-border); border-radius: 12px; padding: 1rem; background: #fdfefe; }
        .manual-step-number { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: rgba(13,110,253,0.12); color: #0b5ed7; font-weight: 700; }
        .manual-step-title { font-weight: 700; margin-bottom: .35rem; }

        .manual-note { border-left: 4px solid #0b5ed7; background: rgba(13,110,253,0.08); padding: .75rem 1rem; border-radius: 10px; color: var(--manual-text); }
        .manual-warning { border-left: 4px solid #eab308; background: rgba(234,179,8,0.1); }
        .manual-success { border-left: 4px solid #22c55e; background: rgba(34,197,94,0.1); }

        .manual-table { width: 100%; border-collapse: collapse; }
        .manual-table th, .manual-table td { border: 1px solid var(--manual-border); padding: .6rem .7rem; vertical-align: top; }
        .manual-table th { background: #f5f7fb; font-weight: 700; }

        @media (max-width: 991.98px) {
            .manual-grid { grid-template-columns: 1fr; }
            .manual-sidebar { position: static; box-shadow: none; }
        }
    </style>
{% endblock %}

{% block main %}
    <div class="manual-container">
        <div class="manual-grid">
            <div class="manual-content">
                <section id="manual-intro" class="manual-hero manual-section">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <h1 class="h4 mb-1">Manuel utilisateur DentalSoft</h1>
                            <p class="mb-0">Guide détaillé pour le personnel médical et administratif : navigation, actions, contrôles et bonnes pratiques.</p>
                        </div>
                        <div class="manual-hero-actions d-flex align-items-center gap-2">
                            <span class="manual-pill"><i class="fas fa-book-open mr-1"></i>Version imprimable</span>
                            <a class="btn btn-primary btn-sm" href="#patients">Aller à Patients</a>
                        </div>
                    </div>
                </section>

                <section class="manual-card manual-section" aria-labelledby="section-overview">
                    <h2 id="section-overview">Comment utiliser ce manuel</h2>
                    <p>Chaque section décrit l’écran, les rôles concernés, les actions disponibles et les workflows pas-à-pas. Les blocs d’astuces indiquent quoi vérifier pour éviter les erreurs.</p>
                    <div class="manual-grid-2 mt-3">
                        <div class="manual-note">
                            <strong>Bonnes pratiques</strong><br>
                            Préparez les données (nom, téléphone) avant de créer un enregistrement pour réduire les doublons.
                        </div>
                        <div class="manual-note manual-warning">
                            <strong>Erreurs fréquentes</strong><br>
                            Ne pas vérifier le rôle connecté avant d’agir entraîne des boutons manquants (ex : encaissement).
                        </div>
                    </div>
                </section>

                {% include 'manual/sections/_patients.html.twig' %}
                {% include 'manual/sections/_consultations.html.twig' %}
                {% include 'manual/sections/_agenda.html.twig' %}
                {% include 'manual/sections/_caisse.html.twig' %}
                {% include 'manual/sections/_finances.html.twig' %}
                {% include 'manual/sections/_administration.html.twig' %}
                {% include 'manual/sections/_bonnes_pratiques.html.twig' %}
                {% include 'manual/sections/_faq.html.twig' %}
                {% include 'manual/sections/_glossaire.html.twig' %}
            </div>

            {% include 'manual/_sidebar.html.twig' %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const links = Array.from(document.querySelectorAll('.manual-sidebar a[href^="#"]'));
            const sections = links
                .map(link => document.querySelector(link.getAttribute('href')))
                .filter(Boolean);

            const setActive = (id) => {
                links.forEach((link) => {
                    const href = link.getAttribute('href');
                    const matches = href === `#${id}`;
                    link.classList.toggle('active', matches);
                });
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        setActive(entry.target.id);
                    }
                });
            }, { rootMargin: '-40% 0px -50% 0px', threshold: [0, 1] });

            sections.forEach((section) => observer.observe(section));
        });
    </script>
{% endblock %}
