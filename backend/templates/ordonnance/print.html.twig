<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Ordonnance</title>

<style>
/* =========================
   BASE GÉNÉRALE
========================= */
html {
    font-size: 16px;
}

body {
    margin: 0;
    padding: 0;
    background: #f2f2f2;
    font-family: "Times New Roman", Times, serif;
    color: #000;
}

/* =========================
   CONTAINER PRINCIPAL
========================= */
.print-ordo-container {
    position: relative;
    max-width: 210mm;
    margin: 12mm auto;
    padding: 18mm 20mm;
    background: #fff;
    box-shadow: 0 0 10mm rgba(0,0,0,0.08);
}

/* Filigrane */
.print-ordo-container::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url('{{ asset('img/logo.png') }}') center no-repeat;
    background-size: 55%;
    opacity: 0.05;
    pointer-events: none;
}

.print-ordo-content {
    position: relative;
    z-index: 1;
}

/* =========================
   EN-TÊTE
========================= */
.ordo-header {
    text-align: center;
    margin-bottom: 2.2rem;
}

.ordo-header img {
    max-height: 85px;
    margin-bottom: 1rem;
}

.ordo-header h1 {
    font-size: 1.8rem;
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.ordo-header hr {
    margin-top: 1rem;
    border: none;
    border-top: 2px solid #000;
}

/* =========================
   INFOS PATIENT
========================= */
.ordo-infos {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.8rem;
    font-size: 1rem;
}

.ordo-infos div {
    line-height: 1.6;
}

.ordo-date {
    font-weight: bold;
    margin-top: 0.3rem;
}

/* =========================
   TABLEAU ORDONNANCE
========================= */
.ordo-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 2rem;
    font-size: 0.95rem;
}

.ordo-table thead th {
    text-align: left;
    border-bottom: 2px solid #000;
    padding: 8px 6px;
    font-weight: bold;
}

.ordo-table tbody td {
    padding: 10px 6px;
    vertical-align: top;
    border-bottom: 1px solid #ddd;
}

.ordo-table td:first-child {
    font-weight: bold;
}

/* =========================
   PIED DE PAGE
========================= */
.ordo-footer {
    font-size: 0.95rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid #aaa;
    color: #333;
}

/* =========================
   SIGNATURE
========================= */
.signature-zone {
    margin-top: 3rem;
    width: 45%;
    margin-left: auto;
    text-align: center;
    font-size: 0.95rem;
}

.signature-zone hr {
    margin-bottom: 6px;
    border: none;
    border-top: 1px solid #000;
}

/* =========================
   BOUTON IMPRESSION
========================= */
.no-print {
    max-width: 210mm;
    margin: 10px auto;
    text-align: right;
}

.no-print button {
    padding: 8px 14px;
    font-size: 14px;
    cursor: pointer;
}

/* =========================
   MODE IMPRESSION
========================= */
@media print {

    @page {
        size: A4;
        margin: 15mm;
    }

    html {
        font-size: 14pt;
    }

    body {
        background: #fff;
    }

    .no-print {
        display: none !important;
    }

    .print-ordo-container {
        margin: 0;
        padding: 18mm 20mm;
        box-shadow: none;
    }

    .print-ordo-container,
    .print-ordo-container * {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
}
</style>
</head>

<body>

<div class="no-print">
    <button onclick="window.print()">Imprimer</button>
</div>

<div class="print-ordo-container">
<div class="print-ordo-content">

    <!-- EN-TÊTE -->
    <div class="ordo-header">
        <img src="{{ asset('img/header-big.jpeg') }}" alt="Logo clinique">
        <h1>Ordonnance</h1>
        <hr>
    </div>

    <!-- INFOS -->
    <div class="ordo-infos">
        <div>
            <strong>Patient :</strong> {{ data.patient ?? '—' }}<br>
            <span class="ordo-date"><strong>Date :</strong> {{ data.date ?? '—' }}</span>
            {% if data.note %}
            <div style="margin-top:6px;">{{ data.note }}</div>
            {% endif %}
        </div>
    </div>

    <!-- TABLEAU -->
    <table class="ordo-table">
        <thead>
            <tr>
                <th>Désignation</th>
                <th width="30%">Posologie</th>
                <th width="20%">Fréquence</th> 
                <th width="10%">Qté</th>
            </tr>
        </thead>
        <tbody>
        {% for ligne in data.lignes %}
            <tr>
                <td>{{ ligne.designation ?? '—' }}</td>
                <td>{{ ligne.posologie ?? '—' }} <small> unités</small> </td>
                <td>{{ ligne.frequence ?? '—' }} <small> par jour</small> </td> 
                <td>{{ ligne.quantite ?? '—' }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune prescription renseignée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <!-- FOOTER -->
    <div class="ordo-footer">
        Merci de suivre rigoureusement la posologie indiquée.
    </div>

    <!-- SIGNATURE -->
    <div class="signature-zone">
        <hr>
        Signature et cachet du médecin
    </div>

</div>
</div>

<script>
window.onload = function () {
    setTimeout(() => window.print(), 200);
};
</script>

</body>
</html>
