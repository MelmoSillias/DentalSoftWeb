<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Fiche #{{ fiche.id }} – {{ patient.nom }} {{ patient.prenom }}</title>
  <style>
    :root {
      --border: #cfd8e3;
      --text: #1f2d3d;
      --muted: #586574;
    }
    * { box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 16px;
      background: #fff;
      color: var(--text);
    }
    header {
      text-align: center;
      margin-bottom: 16px;
    }
    .paper {
      position: relative;
      border: 1px solid var(--border);
      padding: 20px;
      background: #fff;
      overflow: hidden;
    }
    .paper::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('{{ asset('img/logo.png') }}') center center no-repeat;
      background-size: 60% auto;
      opacity: 0.06;
      pointer-events: none;
    }
    .header-banner {
      width: 100%;
      max-height: 110px;
      object-fit: contain;
      margin-bottom: 6px;
    }
    .header-meta {
      font-size: 11px;
      color: var(--muted);
    }
    h1 {
      font-size: 18px;
      margin: 8px 0 4px;
      font-weight: 700;
    }
    h2 {
      font-size: 15px;
      margin: 18px 0 6px;
      font-weight: 700;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 13px;
    }
    th, td {
      border: 1px solid var(--border);
      padding: 8px 10px;
      text-align: left;
      vertical-align: top;
    }
    th {
      width: 28%;
      background: #f6f8fb;
      font-weight: 700;
    }
    .muted { color: var(--muted); }
    ul { margin: 6px 0; padding-left: 18px; }
    ul li { margin: 2px 0; }
    @media print {
      @page { margin: 10mm; }
      body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; color-adjust: exact; } 
      h1, h2 { color: #000; }
    }
  </style>
  <script>
    window.onload = () => window.print();
  </script>
</head>
<body>

  <div class="paper">
    <header>
      <img src="{{ asset('img/header-big.jpeg') }}" alt="Cabinet Dentaire Orodent" class="header-banner"> 
      <h1>Fiche de consultation</h1>
      <small class="muted">N° {{ fiche.id|format('06d') }}</small> 
    </header>

    <h2>Résumé</h2>
    <table>
      <tr><th>Patient</th><td>{{ patient.nom }} {{ patient.prenom }}</td></tr>
      <tr><th>Âge</th><td>{{ patient.getAge() }} ans</td></tr>
      <tr><th>Téléphone</th><td>{{ patient.telephone|default('—') }}</td></tr>
      <tr><th>Date de création</th><td>{{ fiche.createdAt|date('d/m/Y H:i') }}</td></tr>
      
    </table>

    <h2>Motif et historique</h2>
    <table>
      <tr><th>Motif</th><td>{{ fiche.motif|nl2br }}</td></tr>
      <tr><th>Histoire</th><td>{{ fiche.histoireMaladie|nl2br }}</td></tr>
      <tr><th>Soins antérieurs</th><td>{{ fiche.soinsAnterieurs|nl2br }}</td></tr>
      <tr><th>Diagnostic</th><td>{{ fiche.diagnostic|default('—') }}</td></tr>
    </table>

    <h2>Examens cliniques</h2>
    <table>
      <tr><th>Exo-Inspection</th><td>{{ fiche.exoInspection|default('—') }}</td></tr>
      <tr><th>Exo-Palpation</th><td>{{ fiche.exoPalpation|default('—') }}</td></tr>
      <tr><th>Endo-Inspection</th><td>{{ fiche.endoInspection|default('—') }}</td></tr>
      <tr><th>Endo-Palpation</th><td>{{ fiche.endoPalpation|default('—') }}</td></tr>
    </table>

    <h2>Examens dentaires</h2>
    <table>
      <tr><th>Occlusion</th><td>{{ fiche.occlusion|default('—') }}</td></tr>
      <tr><th>Parodontal</th><td>{{ fiche.examenParodontal|default('—') }}</td></tr>
      <tr><th>Diagnostic</th><td>{{ fiche.diagnostic|default('—') }}</td></tr>
    </table>

    <h2>Examens dentaires détaillés</h2>
    {% set teeth = [11,21,12,22,13,23,14,24,15,25,16,26,17,27,18,28,31,41,32,42,33,43,34,44,35,45,36,46,37,47,38,48] %}
          <table style="width:100%; border-collapse:collapse;">
            {% for row in teeth|batch(2, '') %}
              <tr>
                {% for num in row %}
                  <td style="border:1px solid var(--border); padding:6px; width:50%;">
                    {% if num is not empty %}
                      <strong>{{ num }}</strong><br>
                      <span class="muted">{{ fiche.toothChecks[num]|default('') }}</span>
                    {% else %}
                      &nbsp;
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </table>

    <h2>Traitements</h2>
    <table>
      <tr><th>Urgence</th><td>{{ fiche.traitementUrgence|default('—') }}</td></tr>
      <tr><th>Dentaire</th><td>{{ fiche.traitementDentaire|default('—') }}</td></tr>
      <tr><th>Parodontal</th><td>{{ fiche.traitementParodontal|default('—') }}</td></tr>
      <tr><th>Orthodontique</th><td>{{ fiche.traitementOrthodontique|default('—') }}</td></tr>
      <tr><th>Autres</th><td>{{ fiche.autres|default('—') }}</td></tr>
    </table>

    {% if not fiche.devis.isEmpty() %}
      {% set devis = fiche.devis.first() %}
      <h2>Devis</h2>
      <table>
        <tr><th>Date</th><td>{{ devis.date|date('d/m/Y') }}</td></tr>
        <tr><th>Montant total</th><td>{{ devis.montant|number_format(2, ',', ' ') }} FCFA</td></tr>
      </table>
    {% endif %}

    {% if fiche.consultations|length %}
      <h2>Séances passées</h2>
      <table style="width:100%; border-collapse:collapse;">
              <tr>
                <th style="border:1px solid var(--border); padding:6px; width:20%;">Date</th>
                <th style="border:1px solid var(--border); padding:6px; width:35%;">Equipe</th>
                <th style="border:1px solid var(--border); padding:6px;">Actes</th>
              </tr>
              {% for seance in fiche.consultations %}
                <tr>
                  <td style="border:1px solid var(--border); padding:6px;">{{ seance.createdAt|date('d/m/Y') }}</td>
                  <td style="border:1px solid var(--border); padding:6px;">
                    Médecin : {{ seance.medecin ? seance.medecin.nom : '—' }}<br>
                    <hr>
                    Infirmier : {{ seance.infirmier ? seance.infirmier.nom : '—' }}<br>
                    <hr>
                    Salle : {{ seance.salle ? seance.salle.nom : '—' }}
                  </td>
                  <td style="border:1px solid var(--border); padding:6px;">
                    {% if seance.actes|length %}
                      <ul>
                        {% for acte in seance.actes %}
                          <li>{{ acte.description }}</li>
                        {% endfor %}
                      </ul>
                    {% else %}
                      <span class="muted">—</span>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </table>
    {% endif %}
  </div>
</body>
</html>
