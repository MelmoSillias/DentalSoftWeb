{% extends 'layout.html.twig' %}

{% block title %}Mes notifications{% endblock %}

{% block main %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Notifications</h1>
    {% set home_path = is_granted('ROLE_ADMIN') ? path('app_admin_dashboard') : (is_granted('ROLE_MEDECIN') ? path('app_medecin_dashboard') : (is_granted('ROLE_RECEPTION') ? path('app_reception_dashboard') : '#')) %}
    <ol class="breadcrumb mb-4 d-flex flex-wrap">
        <li class="breadcrumb-item"><a href="{{ home_path }}">Dashboard</a></li>
        <li class="breadcrumb-item active">Profil</li>
    </ol>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <div class="btn-group" role="group">
                <a class="btn btn-sm btn-outline-primary {{ filter == 'all' ? 'active' : '' }}" href="{{ path('app_profile_notifications', {filter: 'all'}) }}">Toutes</a>
                <a class="btn btn-sm btn-outline-primary {{ filter == 'non_lu' ? 'active' : '' }}" href="{{ path('app_profile_notifications', {filter: 'non_lu'}) }}">Non lues</a>
                <a class="btn btn-sm btn-outline-primary {{ filter == 'lu' ? 'active' : '' }}" href="{{ path('app_profile_notifications', {filter: 'lu'}) }}">Lues</a>
            </div>
            <span class="badge bg-light text-dark">{{ total }} notification(s)</span>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('app_profile_notifications', {filter: filter, page: page}) }}">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col" style="width:40px;"><input type="checkbox" id="select-all"></th>
                                <th scope="col">Message</th>
                                <th scope="col" class="text-nowrap">Priorité</th>
                                <th scope="col" class="text-nowrap">Statut</th>
                                <th scope="col" class="text-nowrap">Date</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for n in notifications %}
                            <tr class="{{ n.status.value == 'non_lu' ? 'fw-bold' : '' }}">
                                <td><input type="checkbox" name="ids[]" value="{{ n.id }}" class="select-row"></td>
                                <td>{{ n.message }}</td>
                                <td><span class="badge bg-{{ n.priority.value == 'critique' ? 'danger' : (n.priority.value == 'avertissement' ? 'warning text-dark' : 'info') }}">{{ n.priority.value }}</span></td>
                                <td>{{ n.status.value }}</td>
                                <td>{{ n.createdAt ? n.createdAt|date('d/m/Y H:i') : '' }}</td>
                                <td class="text-end">
                                    {% if n.link %}
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_notifications_go', {id: n.id}) }}">Ouvrir</a>
                                    {% endif %}
                                    {% if n.status.value == 'non_lu' %}
                                        <button type="button" class="btn btn-sm btn-outline-success mark-one" data-id="{{ n.id }}">Marquer comme lu</button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center">Aucune notification.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">Marquer sélection comme lue</button>
                    <nav aria-label="Pagination notifications">
                        <ul class="pagination pagination-sm mb-0">
                            {% for p in 1..total_pages %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('app_profile_notifications', {filter: filter, page: p}) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block ownscripts %}
<script>
(function() {
    const selectAll = document.getElementById('select-all');
    const rowChecks = Array.from(document.querySelectorAll('.select-row'));
    if (selectAll) {
        selectAll.addEventListener('change', () => {
            rowChecks.forEach(cb => cb.checked = selectAll.checked);
        });
    }

    document.querySelectorAll('.mark-one').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.dataset.id;
            fetch('{{ path('app_notifications_mark_read') }}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ids: [id]})
            }).then(() => window.location.reload());
        });
    });
})();
</script>
{% endblock %}
