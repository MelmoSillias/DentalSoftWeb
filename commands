cd /var/www
rm -r dentalsoft
gh repo clone MelmoSillias/DentalSoftWeb
mv DentalSoftWeb dentalsoft
cd dentalsoft
composer install --no-dev --optimize-autoloader
rm .env 
mv env .env
mv public/access public/.htaccess 
composer dump-env prod
rm -rf /var/www/dentalsoft/var/cache/prod
php /var/www/dentalsoft/bin/console cache:warmup --env=prod
sudo chown -R www-data:www-data /var/www/dentalsoft/var
sudo chmod -R 775 /var/www/dentalsoft/var
sudo chown -R www-data:www-data /var/www/dentalsoft/public/uploads
sudo chmod -R 775 /var/www/dentalsoft/public/uploads
