# Copier vers .env (Dokploy Environment) — un fichier / stack par cabinet

# Build
CABINET=cdos
BUILD_ENV=prod

# MariaDB
MYSQL_DATABASE=dentalsoft_cdos
MYSQL_USER=dentalsoft
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-root-strong

# App
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-app-secret-32chars-min
APP_PUBLISH_PORT=80
JWT_PASSPHRASE=change-me-jwt-passphrase

# Same-origin admin+API — CORS permissif OK en all-in-one
CORS_ALLOW_ORIGIN=^https?://.*$

# Mail / Messenger
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=default
RUN_MIGRATIONS=1
ENABLE_EMBEDDED_WORKER=1

# Mercure (hub partagé Dokploy — internal host)
MERCURE_URL=http://mercure:80/.well-known/mercure
MERCURE_PUBLIC_URL=https://mercure.example.com/.well-known/mercure
MERCURE_JWT_SECRET=change-me-mercure-secret
MERCURE_TOPIC_NAMESPACE=dentalsoft-cdos
