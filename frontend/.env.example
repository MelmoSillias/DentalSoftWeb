# Exemple local uniquement, sans secret. Copier vers .env.local.
# Le cabinet généré est PRIORITAIRE sur ces deux variables dans src/config.js.
# default/config.dev.json utilise aussi localhost:8000 ; vérifier l'API réellement appelée.
VITE_API_PREFIX=http://localhost:8000/api
VITE_FILE_PREFIX=http://localhost:8000
VITE_DOKPLOY=false

# Opt-in explicite seulement, sur une origine dédiée à la refonte.
VITE_ENABLE_PWA=false
