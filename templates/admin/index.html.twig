{% extends 'appbase.html.twig' %}
{% block title %}Dashboard - Cabinet Dentaire{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <script src="https://printjs-4de6.kxcdn.com/print.min.js"></script>
    <link rel="stylesheet" href="https://printjs-4de6.kxcdn.com/print.min.css">
    <style>
        .card {
            border-radius: 10px;
            transition: transform 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .card-body {
            padding: 1.25rem;
        }
        .text-gray-800 {
            color: #5a5c69 !important;
        }
        .shadow {
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15) !important;
        }
        .btn-outline-primary {
            border-color: #4e73df;
            color: #4e73df;
        }
        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: white;
        }

        @media print {
  body * {
    visibility: hidden;
    margin: 0;
    padding: 0;
  }

  .print-area, .print-area * {
    visibility: visible;
  }

  .print-area {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    padding: 20px 40px;
    font-family: "Times New Roman", serif;
    font-size: 12pt;
    color: #000;
  }

  /* Masquer complètement les badges */
  .badge {
    display: none !important;
  }

  /* Style pour afficher uniquement le contenu texte des badges */
  .badge-content {
    display: inline;
    font-weight: normal;
  }

  .print-header {
    text-align: center;
    border-bottom: 2px solid #000;
    margin-bottom: 25px;
    padding-bottom: 15px;
  }

  .print-header h2 {
    font-size: 18pt;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .print-section-title {
    font-weight: bold;
    font-size: 14pt;
    margin: 25px 0 15px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
  }

  /* Style amélioré pour les données */
  .data-field {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    page-break-inside: avoid;
  }

  .data-label {
    font-weight: bold;
    width: 40%;
  }

  .data-value {
    width: 60%;
    text-align: right;
    font-weight: normal;
  }

  /* Style des listes sans puces ni badges */
  ul.list-group, ol.list-group {
    list-style-type: none;
    padding-left: 0;
    margin: 15px 0;
  }

  ul.list-group li, ol.list-group li {
    border: none;
    padding: 6px 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
  }

  /* Pied de page professionnel */
  .print-footer {
    margin-top: 50px;
    font-size: 10pt;
    border-top: 1px solid #000;
    padding-top: 15px;
    display: flex;
    justify-content: space-between;
  }

  .sign {
    width: 45%;
    text-align: center;
  }

  .sign hr {
    border: none;
    border-top: 1px solid #000;
    width: 80%;
    margin: 15px auto 5px;
  }

  @page {
    size: A4;
    margin: 1.5cm;
    @bottom-center {
      content: "Page " counter(page);
      font-size: 10pt;
    }
  }
} 

    </style>
{% endblock %}
