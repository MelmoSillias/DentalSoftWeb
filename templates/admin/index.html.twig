function formatDoctorTable(row) {
  return `
    <table>
      <thead>
        <tr>
          <th>Indicateur</th>
          <th>Nombre</th>
          <th>Montant total</th>
          <th>Moyenne par consultation</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Consultations réalisées</td>
          <td>${row.consultations || '0'}</td>
          <td>${row.total_amount ? row.total_amount + ' F CFA' : '0 F CFA'}</td>
          <td>${row.avg_amount ? row.avg_amount + ' F CFA' : '0 F CFA'}</td>
        </tr>
        <tr>
          <td>Soins effectués</td>
          <td>${row.acts || '0'}</td>
          <td>${row.acts_amount ? row.acts_amount + ' F CFA' : '0 F CFA'}</td>
          <td>${row.avg_act ? row.avg_act + ' F CFA' : '0 F CFA'}</td>
        </tr>
        <tr>
          <td>Nouveaux patients</td>
          <td>${row.new_patients || '0'}</td>
          <td colspan="2"></td>
        </tr>
        <tr>
          <td>Patients fidélisés</td>
          <td>${row.returning_patients || '0'}</td>
          <td colspan="2"></td>
        </tr>
      </tbody>
    </table>
  `;
}

function formatActsDetails(row) {
  if (!row.actes || row.actes.length === 0) {
    return '<p>Aucun soin disponible pour cette période.</p>';
  }

  let detailsHtml = `
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Patient</th>
          <th>Type d'acte</th>
          <th>Montant</th>
        </tr>
      </thead>
      <tbody>
  `;

  row.actes.forEach(acte => {
    detailsHtml += `
      <tr>
        <td>${acte.date || ''}</td>
        <td>${acte.patient || ''}</td>
        <td>${acte.type || ''}</td>
        <td>${acte.montant ? acte.montant + ' F CFA' : '0 F CFA'}</td>
      </tr>
    `;
  });

  detailsHtml += `
      </tbody>
    </table>
  `;

  return detailsHtml;
}

