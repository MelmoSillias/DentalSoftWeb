<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Reçu de Caisse</title>
  <script src="https://printjs-4de6.kxcdn.com/print.min.js"></script>
  <link rel="stylesheet" href="https://printjs-4de6.kxcdn.com/print.min.css">

  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 14px;
      color: #000;
      margin: 0;
    }
    #receipt-content {
      width: 70mm;
      padding: 5px;
      margin: auto;
    }
    .center { text-align: center; }
    .right  { text-align: right; }
    .bold   { font-weight: bold; }
    hr      { border: none; border-top: 1px dashed #000; margin: 5px 0; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 5px 0;
    }
    th, td {
      padding: 2px 0;
    }
    th { font-weight: bold; }
    .total {
      font-size: 16px;
      font-weight: bold;
    }
    .small {
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div id="receipt-content" class="small">
    <div class="center bold">
      Cabinet Orodent<br>
      Ticket de Consultation
    </div>

    <hr>

    <table class="small">
      <tr>
        <td>Ticket N°</td>
        <td class="right">{{ paiement.id }}</td>
      </tr>
      <tr>
        <td>Date</td>
        <td class="right">{{ paiement.date|date('d/m/Y H:i') }}</td>
      </tr>
      <tr>
        <td>Patient</td>
        <td class="right">{{ paiement.consultation.patient.nom }} {{ paiement.consultation.patient.prenom }}</td>
      </tr>
      <tr>
        <td>Mode</td>
        <td class="right">{{ paiement.mode.libelle }}</td>
      </tr>
    </table>

    <hr>

    <table>
      <thead>
        <tr>
          <th>Description</th>
          <th class="right">Montant</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Ticket de consultation #{{ paiement.id }}</td>
          <td class="right">{{ paiement.montant|number_format(0, ',', ' ') }} FCFA</td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td class="bold">Total payé</td>
          <td class="right bold">{{ paiement.montant|number_format(0, ',', ' ') }} FCFA</td>
        </tr>
      </tfoot>
    </table>

    <hr>

    <div class="small center">
      Merci de votre confiance !<br>
      Contact: +223 XX XX XX XX
    </div>
  </div>

  <script>
    window.onload = function () {
      printJS({
        printable: 'receipt-content',
        type: 'html',
        targetStyles: ['*'],
        style: '@page { 80mm 80mm; auto; margin: 2mm; }',
      });

      // Ferme la fenêtre après un délai (si compatible)
      setTimeout(() => {
        window.close();
      }, 1000);
    };
  </script>
</body>
</html>
