<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Reçu de Caisse</title>
  <script src="https://printjs-4de6.kxcdn.com/print.min.js"></script>
  <link rel="stylesheet" href="https://printjs-4de6.kxcdn.com/print.min.css">

  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 9px; /* Taille de police réduite */
      color: #000;
      margin: 0;
      padding: 0;
    }
    #receipt-content {
      width: 57mm;
      height: 90mm;
      padding: 2mm;
      margin: 0;
      box-sizing: border-box;
      overflow: hidden;
    }
    .center { text-align: center; }
    .right  { text-align: right; }
    .bold   { font-weight: bold; }
    hr      { 
      border: none; 
      border-top: 1px dashed #000; 
      margin: 3px 0; /* Marge réduite */
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 3px 0; /* Marge réduite */
    }
    th, td {
      padding: 1px 0; /* Padding réduit */
    }
    th { font-weight: bold; }
    .total {
      font-size: 10px; /* Taille réduite */
      font-weight: bold;
    }
    .small {
      font-size: 7px; /* Taille réduite */
    }
  </style>
</head>
<body>
  <div id="receipt-content" class="small">
    <div class="center bold">
      Cabinet Orodent<br>
      Ticket de Consultation
    </div>

    <hr>

    <table class="small">
    <tr>
      <td>Reçu N°</td>
      <td class="right">{{ paiement.id }}</td>
    </tr>
    <tr>
      <td>Date</td>
      <td class="right">{{ paiement.date|date('d/m/Y H:i') }}</td>
    </tr>
    <tr>
      <td>Patient</td>
      <td class="right">{{ paiement.devis.fiche.patient.nom }} {{ paiement.devis.fiche.patient.prenom }}</td>
    </tr>
    <tr>
      <td>Mode</td>
      <td class="right">{{ paiement.mode.libelle }}</td>
    </tr>
  </table>

  <hr>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th class="right">Montant</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Paiement devis #{{ paiement.devis.id }}</td>
        <td class="right">{{ paiement.montant|number_format(0, ',', ' ') }} FCFA</td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <td class="bold">Total payé</td>
        <td class="right bold">{{ paiement.montant|number_format(0, ',', ' ') }} FCFA</td>
      </tr>
    </tfoot>
  </table>

    <hr>

    <div class="small center">
      Merci de votre confiance !<br>
      Contact: +223 XX XX XX XX
    </div>
  </div>

  <script>
    window.onload = function () {
      printJS({
        printable: 'receipt-content',
        type: 'html',
        targetStyles: ['*'],
        style: '@page { 57mm 90mm; auto; margin: 2mm; }',
      });

      // Ferme la fenêtre après un délai (si compatible)
      setTimeout(() => {
        window.close();
      }, 1000);
    };
  </script>
</body>
</html>



