{% extends 'appmedecinbase.html.twig' %}

{% block title %}Dashboard - Médecin
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css"/>
	<style>
		.card {
			border-radius: 10px;
			transition: transform 0.3s;
		}
		.card:hover {
			transform: translateY(-5px);
		}
		.card-body {
			padding: 1.25rem;
		}
		.text-gray-800 {
			color: #5a5c69 !important;
		}
		.shadow {
			box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15) !important;
		}
		.btn-outline-primary {
			border-color: #4e73df;
			color: #4e73df;
		}
		.btn-outline-primary:hover {
			background-color: #4e73df;
			color: white;
		}
	</style>
{% endblock %}

{% block main %}
	<div class="container-fluid py-4 px-4">
		<div class="d-sm-flex align-items-center justify-content-between mb-4">
			<h1 class="h2 mb-0 text-gray-800">Bienvenue Dr
				<span id="doctorName">
					--
				</span>
			</h1>
		</div>

		<section id="globalStats">
			<h4 class="mb-2 text-secondary">Statistiques Globales</h4>
			<div
				class="row">
				<!-- Nombre total de patients consultés -->
				<div class="col-xl-3 col-md-6 mb-4">
					<div class="card border-left-primary shadow h-100 py-2">
						<div class="card-body">
							<div class="row no-gutters align-items-center">
								<div class="col mr-2">
									<div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
										Patients Consultés
									</div>
									<div id="patientsTotal" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
								</div>
								<div class="col-auto">
									<i class="fas fa-user fa-2x text-gray-300"></i>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Employé depuis -->
				<div class="col-xl-3 col-md-6 mb-4">
					<div class="card border-left-success shadow h-100 py-2">
						<div class="card-body">
							<div class="row no-gutters align-items-center">
								<div class="col mr-2">
									<div class="text-xs font-weight-bold text-success text-uppercase mb-1">
										Employé depuis
									</div>
									<div id="employedSince" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
								</div>
								<div class="col-auto">
									<i class="fas fa-calendar fa-2x text-gray-300"></i>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Type de salaire -->
				<div class="col-xl-3 col-md-6 mb-4">
					<div class="card border-left-info shadow h-100 py-2">
						<div class="card-body">
							<div class="row no-gutters align-items-center">
								<div class="col mr-2">
									<div class="text-xs font-weight-bold text-info text-uppercase mb-1">
										Type de Salaire
									</div>
									<div id="salaryType" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
								</div>
								<div class="col-auto">
									<i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Nombre total de consultations -->
				<div class="col-xl-3 col-md-6 mb-4">
					<div class="card border-left-dark shadow h-100 py-2">
						<div class="card-body">
							<div class="row no-gutters align-items-center">
								<div class="col mr-2">
									<div class="text-xs font-weight-bold text-dark text-uppercase mb-1">
										Consultations Totales
									</div>
									<div id="totalConsultations" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
								</div>
								<div class="col-auto">
									<i class="fas fa-notes-medical fa-2x text-gray-300"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Consultations en attente et RDV du jour -->
		<div class="row">
			<div class="col-xl-6 col-md-6 mb-4">
				<div class="card border-left-warning shadow h-100 py-2">
					<div class="card-body">
						<div class="row no-gutters align-items-center">
							<div class="col mr-2">
								<div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
									Consultations en attente
								</div>
								<div id="pendingConsultations" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
							</div>
							<div class="col-auto">
								<i class="fas fa-clock fa-2x text-gray-300"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-xl-6 col-md-6 mb-4">
				<div class="card border-left-info shadow h-100 py-2">
					<div class="card-body">
						<div class="row no-gutters align-items-center">
							<div class="col mr-2">
								<div class="text-xs font-weight-bold text-info text-uppercase mb-1">
									Rendez-vous du jour
								</div>
								<div id="todayAppointments" class="h6 mb-0 font-weight-bold text-gray-800">--</div>
							</div>
							<div class="col-auto">
								<i class="fas fa-calendar-check fa-2x text-gray-300"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Détails périodiques -->
		<div class="row mt-4">
			<div class="col-12">
				<h4 class="mb-3 text-secondary">Détails Périodiques</h4>
			</div>
			<!-- Consultations -->
			<div class="col-xl-4 col-lg-6 col-md-12 mb-4">
				<div class="card h-100 border-left-primary shadow">
					<div class="card-header d-flex justify-content-between align-items-center py-2">
						<h6 class="mb-0">Consultations</h6>
					</div>
					<ul class="list-group list-group-flush">
						<li class="list-group-item d-flex justify-content-between">
							Gratuites
							<span id="freeConsultations" class="badge badge-primary">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Payantes
							<span id="paidConsultations" class="badge badge-secondary">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Total
							<span id="AmountConsultations" class="badge badge-success">--</span>
						</li>
					</ul>
				</div>
			</div>
			<!-- Rendez-vous -->
			<div class="col-xl-4 col-lg-6 col-md-12 mb-4">
				<div class="card h-100 border-left-success shadow">
					<div class="card-header d-flex justify-content-between align-items-center py-2">
						<h6 class="mb-0">Rendez-vous</h6>
					</div>
					<ul class="list-group list-group-flush">
						<li class="list-group-item d-flex justify-content-between">
							Planifiés
							<span id="scheduledAppointments" class="badge badge-primary">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							En attente
							<span id="pendingAppointments" class="badge badge-secondary">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Validés
							<span id="confirmedAppointments" class="badge badge-success">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Reportés
							<span id="postponedAppointments" class="badge badge-warning">--</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Annulés
							<span id="cancelledAppointments" class="badge badge-danger">--</span>
						</li>
					</ul>
				</div>
			</div>
			<!-- Apport durant la période -->
			<div class="col-xl-4 col-lg-6 col-md-12 mb-4">
				<div class="card h-100 border-left-info shadow">
					<div class="card-header d-flex justify-content-between align-items-center py-2">
						<h6 class="mb-0">Apport durant la période</h6>
					</div>
					<ul class="list-group list-group-flush">
						<li class="list-group-item d-flex justify-content-between">
							Total sur consultations
							<span id="periodRevenueC" class="badge badge-primary">-- Fcfa</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Total sur soins éffectués
							<span id="periodRevenueA" class="badge badge-secondary">-- Fcfa</span>
						</li>
						<li class="list-group-item d-flex justify-content-between">
							Montant Total
							<span id="periodRevenueT" class="badge badge-success">-- Fcfa</span>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<!-- Actes médicaux posés -->
		<div class="row mt-4">
			<div class="col-12">
				<div class="card h-100 border-left-secondary shadow">
					<div class="card-header d-flex justify-content-between align-items-center py-2">
						<h6 class="mb-0">Soins médicaux</h6>
					</div>
					<ul
						class="list-group list-group-flush" id="medicalActsList"><!-- Contenu dynamique pour les actes médicaux -->
					</ul>
				</div>
			</div>
		</div>

		<!-- Détails de l'employé -->
		<!-- Détails de l'employé -->
		<div class="row mt-5">
			<div class="col-12">
				<div class="card shadow mb-4">
					<div class="card-header py-3">
						<h6 class="m-0 font-weight-bold text-primary">
							<i class="fas fa-id-card me-1"></i>Informations personnelles de l'employé
						</h6>
					</div>
					<div class="card-body">
						<div class="row gx-4">
							<div class="col-md-6">
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Nom</label>
									<div class="col-sm-8">
										<input type="text" id="nom" class="form-control" value="">
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Prénom</label>
									<div class="col-sm-8">
										<input type="text" id="prenom" class="form-control" value="">
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Matricule</label>
									<div class="col-sm-8">
										<input type="text" id="matricule" class="form-control" value="" readonly>
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Fonction</label>
									<div class="col-sm-8">
										<input type="text" id="fonction" class="form-control" value="">
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Type</label>
									<div class="col-sm-8">
										<select id="typeSelect" class="form-select form-control" disabled>
											<option value="Medecin">Médecin</option>
											<option value="GRH">GRH</option>
											<option value="Receptionniste">Réceptionniste</option>
											<option value="Admin">Admin</option>
											<option value="Autre">Autre</option>
										</select>
										<input type="hidden" id="typeHidden" value="">
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Téléphone</label>
									<div class="col-sm-8">
										<input type="tel" id="telephone" class="form-control" value="">
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Email</label>
									<div class="col-sm-8">
										<input type="email" id="email" class="form-control" value="">
									</div>
								</div>
								<div class="mb-3 row">
									<label class="col-sm-4 col-form-label">Date d'embauche</label>
									<div class="col-sm-8">
										<input type="date" id="dateEmbauche" class="form-control" value="" readonly>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-5">
			<div class="col-12">
				<div class="card shadow mb-4">
					<div class="card-header py-3">
						<h6 class="m-0 font-weight-bold text-primary">
							<i class="fas fa-user-md mr-2"></i>Profil du Médecin
						</h6>
					</div>
					<div
						class="card-body">

						<!-- Boutons de contrôle -->
						<div class="mb-3 d-flex justify-content-end gap-2">
							<button class="btn btn-sm btn-outline-secondary" data-toggle="collapse" data-target="#collapseInfosPerso">
								<i class="fas fa-id-card mr-1"></i>
								Infos personnelles
							</button>
							<button class="btn btn-sm btn-outline-secondary" data-toggle="collapse" data-target="#collapseInfosRH">
								<i class="fas fa-briefcase mr-1"></i>
								Infos RH
							</button>
						</div>

						<!-- Infos personnelles -->
						<div class="collapse" id="collapseInfosPerso">
							<div class="mb-4">
								<h6 class="text-secondary mb-3">
									<i class="fas fa-id-card mr-1"></i>
									Informations personnelles</h6>
								<div class="row">
									<div class="col-md-6">
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Nom</label>
											<div class="col-sm-8">
												<input type="text" id="nom" class="form-control">
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Prénom</label>
											<div class="col-sm-8">
												<input type="text" id="prenom" class="form-control">
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Matricule</label>
											<div class="col-sm-8">
												<input type="text" id="matricule" class="form-control" readonly>
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Fonction</label>
											<div class="col-sm-8">
												<input type="text" id="fonction" class="form-control">
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Type</label>
											<div class="col-sm-8">
												<select id="typeSelect" class="form-control" disabled>
													<option value="Medecin">Médecin</option>
													<option value="GRH">GRH</option>
													<option value="Receptionniste">Réceptionniste</option>
													<option value="Admin">Admin</option>
													<option value="Autre">Autre</option>
												</select>
												<input type="hidden" id="typeHidden">
											</div>
										</div>
									</div>
									<div class="col-md-6">
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Téléphone</label>
											<div class="col-sm-8">
												<input type="tel" id="telephone" class="form-control">
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Email</label>
											<div class="col-sm-8">
												<input type="email" id="email" class="form-control">
											</div>
										</div>
										<div class="form-group row">
											<label class="col-sm-4 col-form-label">Date d'embauche</label>
											<div class="col-sm-8">
												<input type="date" id="dateEmbauche" class="form-control" readonly>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Infos RH -->
						<div class="collapse" id="collapseInfosRH">
							<div>
								<h6 class="text-secondary mb-3">
									<i class="fas fa-briefcase mr-1"></i>
									Informations RH</h6>
								<div class="row">
									<div class="col-md-6 form-group row">
										<label class="col-sm-5 col-form-label">Type de Salaire</label>
										<div class="col-sm-7">
											<select id="typeSalaire" class="form-control">
												<option value="fixe">Fixe</option>
												<option value="pourcentage">Pourcentage</option>
											</select>
										</div>
									</div>
									<div class="col-md-6 form-group row">
										<label class="col-sm-5 col-form-label">Valeur du Salaire (€)</label>
										<div class="col-sm-7">
											<input type="number" step="0.01" id="valeurSalaire" class="form-control">
										</div>
									</div>
									<div class="col-md-6 form-group row">
										<label class="col-sm-5 col-form-label">Type de Contrat</label>
										<div class="col-sm-7">
											<input type="text" id="typeContrat" class="form-control">
										</div>
									</div>
									<div class="col-md-6 form-group row">
										<label class="col-sm-5 col-form-label">Durée de contrat (mois)</label>
										<div class="col-sm-7">
											<input type="number" id="dureeContrat" class="form-control">
										</div>
									</div>

								</div>
							</div>
						</div>
						<!-- fin infos RH -->
					</div>
				</div>
			</div>
		</div>

 
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
	<script src="{{ asset('js/medecin/dashboard.js') }}"></script>
{% endblock %}
