<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Fiche #{{ fiche.id }} – {{ patient.nom }} {{ patient.prenom }}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
    }
    header {
      text-align: center;
      margin-bottom: 30px;
    }
    h2 {
      margin-top: 25px;
      border-bottom: 1px solid #ccc;
      padding-bottom: 5px;
    }
    .section {
      margin-bottom: 25px;
    }
    .field { 
      padding: 10px 0;
    }
    .field .label {
      font-weight: bold;
      display: block;
      margin-bottom: 6px;
    }
    .field .value {
      margin-left: 20px;           /* Décalage horizontal */
      border-left: 3px solid #ccc; /* Bordure verticale */
      padding-left: 10px;
      white-space: pre-wrap;       /* Conserver retours à la ligne */
    }
    .tooth-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
    .tooth-cell {
      border: 1px solid #ddd;
      padding: 5px;
    }
  </style>
  <script>
    window.onload = () => window.print();
  </script>
</head>
<body>

  <header>
    <img src="{{ asset('img/logo.png') }}" alt="Logo Cabinet" style="max-height:60px"><br>
    <strong>Cabinet Orodent</strong><br>
    123 Rue de la Santé, Bamako — Tél. +223 20 00 00 00<br>
    SIRET 123 456 789 00010
  </header>

  <h2>Fiche de consultation – Réf. #{{ fiche.id }}</h2>

  <div class="section">
    <div class="field">
      <div class="label">Patient :</div>
      <div class="value">{{ patient.nom }} {{ patient.prenom }}</div>
    </div>
    <div class="field">
      <div class="label">Date :</div>
      <div class="value">{{ fiche.createdAt|date('d/m/Y H:i') }}</div>
    </div>
  </div>

  <h2>Motif & Historique</h2>
  <div class="section">
    <div class="field">
      <div class="label">Motif :</div>
      <div class="value">{{ fiche.motif|nl2br }}</div>
    </div>
    <div class="field">
      <div class="label">Histoire :</div>
      <div class="value">{{ fiche.histoireMaladie|nl2br }}</div>
    </div>
    <div class="field">
      <div class="label">Soins antérieurs :</div>
      <div class="value">{{ fiche.soinsAnterieurs|nl2br }}</div>
    </div>
  </div>

  <h2>Examens</h2>
  <div class="section">
    <div class="field">
      <div class="label">Exo-Inspection :</div>
      <div class="value">{{ fiche.exoInspection|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Exo-Palpation :</div>
      <div class="value">{{ fiche.exoPalpation|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Endo-Inspection :</div>
      <div class="value">{{ fiche.endoInspection|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Endo-Palpation :</div>
      <div class="value">{{ fiche.endoPalpation|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Occlusion :</div>
      <div class="value">{{ fiche.occlusion|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Parodontal :</div>
      <div class="value">{{ fiche.examenParodontal|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Diagnostic :</div>
      <div class="value">{{ fiche.diagnostic|default('—') }}</div>
    </div>
  </div>

  <h2>Examens dentaires détaillés</h2>
  <div class="section tooth-grid">
    {% for pair in [
        [11,21],[12,22],[13,23],[14,24],[15,25],[16,26],[17,27],[18,28],
        [31,41],[32,42],[33,43],[34,44],[35,45],[36,46],[37,47],[38,48]
      ] %}
      {% for num in pair %}
        <div class="tooth-cell">
          <strong>{{ num }}</strong><br>
          {{ fiche.toothChecks[num]|default('') }}
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  <h2>Traitements</h2>
  <div class="section">
    <div class="field">
      <div class="label">Urgence :</div>
      <div class="value">{{ fiche.traitementUrgence|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Dentaire :</div>
      <div class="value">{{ fiche.traitementDentaire|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Parodontal :</div>
      <div class="value">{{ fiche.traitementParodontal|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Orthodontique :</div>
      <div class="value">{{ fiche.traitementOrthodontique|default('—') }}</div>
    </div>
    <div class="field">
      <div class="label">Autres :</div>
      <div class="value">{{ fiche.autres|default('—') }}</div>
    </div>
  </div>

  {% if not fiche.devis.isEmpty() %}
    {% set devis = fiche.devis.first() %}
    <h2>Devis</h2>
    <div class="section">
      <div class="field">
        <div class="label">Date :</div>
        <div class="value">{{ devis.date|date('d/m/Y') }}</div>
      </div>
      <div class="field">
        <div class="label">Montant total :</div>
        <div class="value">{{ devis.montant|number_format(2, ',', ' ') }} FCFA</div>
      </div>
    </div>
  {% endif %}

  {% if fiche.consultations|length %}
    <h2>Séances passées</h2>
    <div class="section">
      {% for seance in fiche.consultations %}
        <div class="field">
          <div class="label">
            {{ seance.createdAt|date('d/m/Y') }} —
            Médecin : {{ seance.medecin ? seance.medecin.nom : '—' }} |
            Infirmier : {{ seance.infirmier ? seance.infirmier.nom : '—' }} |
            Salle : {{ seance.salle ? seance.salle.nom : '—' }}
          </div>
          <div class="value">
            <ul>
              {% for acte in seance.actes %}
                <li>{{ acte.description }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %} 
</body>
</html>
